<Window x:Class="PDFreader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFreader" Height="860" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ToolGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource ToggleButtonStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- ===== App bar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Chrome}" Padding="10,6">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="14"
                                   Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="PDFreader" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="OnOpenClick" ToolTip="Open (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;"/>
                            <TextBlock Text="Open" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Click="OnSaveClick" ToolTip="Save annotated copy (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;"/>
                            <TextBlock Text="Save" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnExportClick" ToolTip="Export (Ctrl+Shift+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;"/>
                            <TextBlock Text="Export" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnPrintClick" ToolTip="Print (Ctrl+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE749;"/>
                            <TextBlock Text="Print" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource ChromeSeparator}"/>
                    <Button Click="OnUndoClick" ToolTip="Undo (Ctrl+Z)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;"/>
                            <TextBlock Text="Undo" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnRedoClick" ToolTip="Redo (Ctrl+Y)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;"/>
                            <TextBlock Text="Redo" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource ChromeSeparator}"/>
                    <Button x:Name="SidebarButton" Click="OnSidebarClick" ToolTip="Toggle sidebar" Tag="active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE700;"/>
                            <TextBlock Text="Sidebar" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnNotesClick" ToolTip="Notebook (Ctrl+M)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70B;"/>
                            <TextBlock Text="Notes" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnInsertImageClick" ToolTip="Stamp an image on the current page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE91B;"/>
                            <TextBlock Text="Insert image" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="DocLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ===== Document tabs ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <StackPanel Orientation="Horizontal" Margin="10,6,4,0">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
                    <Button Click="OnOpenClick" ToolTip="New tab (open PDF)" Height="28" Width="28"
                            Style="{StaticResource ToggleButtonStyle}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Chrome}"
                BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Ready. Open a PDF to begin." FontSize="11"
                           Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="MarkupText" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== Body: rail + panel + viewer ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Icon rail -->
            <Border Grid.Column="0" x:Name="Rail" Width="48" Background="{StaticResource Brush.Chrome}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,6">
                    <Button x:Name="RailPages" Style="{StaticResource RailButton}" Click="OnRailClick" Tag="pages active"
                            ToolTip="Pages"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;"/></Button>
                    <Button x:Name="RailOutline" Style="{StaticResource RailButton}" Click="OnRailClick" Tag="outline"
                            ToolTip="Outline"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;"/></Button>
                    <Button x:Name="RailSearch" Style="{StaticResource RailButton}" Click="OnRailClick" Tag="search"
                            ToolTip="Search (Ctrl+F)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/></Button>
                    <Button x:Name="RailNotes" Style="{StaticResource RailButton}" Click="OnRailClick" Tag="notes"
                            ToolTip="Notes (Ctrl+M)"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70B;"/></Button>
                    <Button x:Name="RailBookmarks" Style="{StaticResource RailButton}" Click="OnRailClick" Tag="bookmarks"
                            ToolTip="Bookmarks"><TextBlock Style="{StaticResource Glyph}" Text="&#xE718;"/></Button>
                </StackPanel>
            </Border>

            <!-- Side panel -->
            <Border Grid.Column="1" x:Name="SidePanel" Width="224" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Pages -->
                    <Grid x:Name="PanelPages">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="12,10,12,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="PageCountBadge" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                            <TextBlock Text="PAGES" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextMuted}"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="ThumbList" SelectionChanged="ThumbList_SelectionChanged"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="10,3">
                                            <Border Background="#FAFAF8" BorderBrush="{StaticResource Brush.BorderSubtle}"
                                                    BorderThickness="1" CornerRadius="2">
                                                <Image Source="{Binding Image}" Stretch="Uniform"/>
                                            </Border>
                                            <Grid Margin="2,4,2,6">
                                                <TextBlock Text="{Binding PageNumber}" FontSize="11"
                                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                                                <TextBlock Text="Reading" FontSize="10" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Brush.Accent}"
                                                           Visibility="{Binding ReadingVisibility}"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                    <!-- Outline -->
                    <TreeView x:Name="OutlineTree" Visibility="Collapsed" Margin="8,8"
                              SelectedItemChanged="OutlineTree_SelectedItemChanged"/>
                    <!-- Search -->
                    <DockPanel x:Name="PanelSearch" Visibility="Collapsed" Margin="10,10">
                        <DockPanel DockPanel.Dock="Top">
                            <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Click="OnSearchSubmitClick" ToolTip="Search" Margin="6,0,0,0" AutomationProperties.Name="Run search">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/>
                            </Button>
                        </DockPanel>
                        <ListBox x:Name="SearchResults" SelectionChanged="SearchResults_SelectionChanged" Margin="0,10,0,0"/>
                    </DockPanel>
                    <!-- Bookmarks -->
                    <DockPanel x:Name="PanelBookmarks" Visibility="Collapsed" Margin="10,10">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Click="OnAddBookmarkClick" ToolTip="Bookmark current page">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE718;"/>
                            </Button>
                            <TextBox x:Name="BookmarkBox" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        </DockPanel>
                        <ListBox x:Name="BookmarkList" SelectionChanged="BookmarkList_SelectionChanged"
                                 DisplayMemberPath="Label" Margin="0,10,0,0"/>
                    </DockPanel>
                    <!-- Notes -->
                    <DockPanel x:Name="PanelNotes" Visibility="Collapsed" Margin="10,10">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Click="OnNewNoteClick" ToolTip="New note">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/>
                            </Button>
                            <TextBlock Text="NOTEBOOK" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox DockPanel.Dock="Top" x:Name="NoteList" Height="120" Margin="0,8,0,0"
                                 SelectionChanged="NoteList_SelectionChanged" DisplayMemberPath="Title"/>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Top" x:Name="NoteTitle" TextChanged="NoteTitle_TextChanged" Margin="0,4,0,6"/>
                            <TextBox x:Name="NoteBody" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" TextChanged="NoteBody_TextChanged"/>
                        </DockPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Main: page toolbar + viewer -->
            <Grid Grid.Column="2" Background="{StaticResource Brush.Viewport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource Brush.Chrome}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="8,4">
                    <DockPanel>
                        <!-- Right utilities -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="OnUndoClick" ToolTip="Undo (Ctrl+Z)" Width="28">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;"/>
                            </Button>
                            <Button Click="OnRedoClick" ToolTip="Redo (Ctrl+Y)" Width="28">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;"/>
                            </Button>
                        </StackPanel>
                        <!-- Left: sidebar toggle, doc name, page pill, arrows -->
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnSidebarClick" ToolTip="Toggle sidebar" Width="28">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE700;"/>
                            </Button>
                            <TextBlock x:Name="ToolbarDocName" Margin="6,0,10,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" FontSize="12"/>
                            <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PageBox" Width="36" TextAlignment="Center" KeyDown="PageBox_KeyDown"
                                             Background="Transparent" BorderThickness="0" Margin="3,3"
                                             AutomationProperties.Name="Current page"/>
                                    <TextBlock Text="/" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PageCountText" Foreground="{StaticResource Brush.TextMuted}"
                                               VerticalAlignment="Center" Margin="4,0,8,0" Text="–"/>
                                </StackPanel>
                            </Border>
                            <Button Click="OnPrevPageClick" x:Name="PrevButton" ToolTip="Previous page (Page Up)" Width="28"
                                    AutomationProperties.Name="Previous page">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;"/>
                            </Button>
                            <Button Click="OnNextPageClick" x:Name="NextButton" ToolTip="Next page (Page Down)" Width="28"
                                    AutomationProperties.Name="Next page">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Second toolbar row: zoom + tools -->
                <Border Grid.Row="1" Background="{StaticResource Brush.Chrome}" Padding="8,4"
                        BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="OnSaveClick" ToolTip="Download annotated copy" Width="28" AutomationProperties.Name="Save annotated copy">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;"/>
                            </Button>
                            <Button Click="OnPrintClick" ToolTip="Print (Ctrl+P)" Width="28">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE749;"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnZoomOutClick" ToolTip="Zoom out (Ctrl+-)" Width="28" AutomationProperties.Name="Zoom out">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE738;"/>
                            </Button>
                            <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="42" TextAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}">100%</TextBlock>
                            <Button Click="OnZoomInClick" ToolTip="Zoom in (Ctrl++)" Width="28" AutomationProperties.Name="Zoom in">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;"/>
                            </Button>
                            <Button Click="OnFitWidthClick" ToolTip="Fit width (Ctrl+1)" Width="28" AutomationProperties.Name="Fit width">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A9;"/>
                            </Button>
                            <Button Click="OnFitPageClick" ToolTip="Fit page (Ctrl+2)" Width="28" AutomationProperties.Name="Fit page">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;"/>
                            </Button>
                            <Button Click="OnRotateClick" ToolTip="Rotate 90° (Ctrl+R)" Width="28" AutomationProperties.Name="Rotate">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7AD;"/>
                            </Button>
                            <Separator Style="{StaticResource ChromeSeparator}"/>
                            <Button x:Name="ToolSelect" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Select"
                                    ToolTip="Select" Width="30" AutomationProperties.Name="Select tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE7B3;"/>
                            </Button>
                            <Button x:Name="ToolInk" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Ink"
                                    ToolTip="Pen" Width="30" AutomationProperties.Name="Pen tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE70F;"/>
                            </Button>
                            <Button x:Name="ToolHighlighter" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Highlighter"
                                    ToolTip="Highlighter" Width="30" AutomationProperties.Name="Highlighter tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE865;"/>
                            </Button>
                            <Button x:Name="ToolRectangle" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Rectangle"
                                    ToolTip="Rectangle" Width="30" AutomationProperties.Name="Rectangle tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE371;"/>
                            </Button>
                            <Button x:Name="ToolEllipse" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Ellipse"
                                    ToolTip="Ellipse" Width="30" AutomationProperties.Name="Ellipse tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE2E5;"/>
                            </Button>
                            <Button x:Name="ToolArrow" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Arrow"
                                    ToolTip="Arrow" Width="30" AutomationProperties.Name="Arrow tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE727;"/>
                            </Button>
                            <Button x:Name="ToolEraser" Style="{StaticResource ToggleButtonStyle}" Click="OnToolClick" Tag="Eraser"
                                    ToolTip="Eraser" Width="30" AutomationProperties.Name="Eraser tool">
                                <TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE75C;"/>
                            </Button>
                            <Border Background="{StaticResource Brush.SurfaceRaised}" CornerRadius="5" Margin="6,0"
                                    VerticalAlignment="Center" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Swatch1" Click="OnSwatchClick" Tag="#F7768E" Width="18" Height="18"
                                            Background="#F7768E" BorderBrush="#3A3E4B" BorderThickness="1"
                                            Padding="0" MinHeight="0" MinWidth="0" ToolTip="Coral"/>
                                    <Button x:Name="Swatch2" Click="OnSwatchClick" Tag="#FAB387" Width="18" Height="18" Margin="4,0,0,0"
                                            Background="#FAB387" BorderBrush="#3A3E4B" BorderThickness="1"
                                            Padding="0" MinHeight="0" MinWidth="0" ToolTip="Peach"/>
                                    <Button x:Name="Swatch3" Click="OnSwatchClick" Tag="#A6E3A1" Width="18" Height="18" Margin="4,0,0,0"
                                            Background="#A6E3A1" BorderBrush="#3A3E4B" BorderThickness="1"
                                            Padding="0" MinHeight="0" MinWidth="0" ToolTip="Mint"/>
                                    <Button x:Name="Swatch4" Click="OnSwatchClick" Tag="#89DCEB" Width="18" Height="18" Margin="4,0,0,0"
                                            Background="#89DCEB" BorderBrush="#3A3E4B" BorderThickness="1"
                                            Padding="0" MinHeight="0" MinWidth="0" ToolTip="Sky"/>
                                    <Button x:Name="Swatch5" Click="OnSwatchClick" Tag="#89B4FA" Width="18" Height="18" Margin="4,0,0,0"
                                            Background="#89B4FA" BorderBrush="#3A3E4B" BorderThickness="1"
                                            Padding="0" MinHeight="0" MinWidth="0" ToolTip="Blue"/>
                                    <Button x:Name="Swatch6" Click="OnSwatchClick" Tag="#111111" Width="18" Height="18" Margin="4,0,0,0"
                                            Background="#111111" BorderBrush="#3A3E4B" BorderThickness="1"
                                            Padding="0" MinHeight="0" MinWidth="0" ToolTip="Black"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ContentControl Grid.Row="2" x:Name="ViewerHost"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <TextBlock Grid.Row="2" x:Name="EmptyState" Text="Open a PDF to begin — drag one here or press Ctrl+O."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="15"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
