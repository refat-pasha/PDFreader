<Window x:Class="PDFreader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PDFreader" Height="860" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="Brush.Background" Color="#1B1D23"/>
        <SolidColorBrush x:Key="Brush.Surface" Color="#23252D"/>
        <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#2A2D37"/>
        <SolidColorBrush x:Key="Brush.Border" Color="#3A3E4B"/>
        <SolidColorBrush x:Key="Brush.Text" Color="#ECEEF3"/>
        <SolidColorBrush x:Key="Brush.TextMuted" Color="#9BA0AF"/>
        <SolidColorBrush x:Key="Brush.Accent" Color="#7AA2F7"/>
        <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#323643"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Dark menu styling: the default Aero2 template renders a white popup,
             which clashes with the app-wide light text and hides menu items. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource Brush.Border}"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" SharedSizeGroup="Icon"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon"
                                                      VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                      Margin="4,5" RecognizesAccessKey="True"/>
                                    <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                               Margin="14,5,8,5" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                    <TextBlock x:Name="Arrow" Grid.Column="3" Text="▶" FontSize="9"
                                               Margin="6,5,10,5" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Brush.SurfaceRaised}"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                        CornerRadius="5" MinWidth="200" Margin="0,2,10,10" Padding="0,4">
                                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-7"/>
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Padding" Value="10,5"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuItem">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                <Setter TargetName="IconHost" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <!-- Keep header text light even though the popup is dark. -->
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}" Foreground="{StaticResource Brush.Text}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open PDF… (Ctrl+O)" Click="OnOpenClick"/>
                <MenuItem Header="Open _Recent" x:Name="RecentMenu"/>
                <MenuItem Header="Save annotated copy (Ctrl+S)" Click="OnSaveClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo (Ctrl+Z)" Click="OnUndoClick"/>
                <MenuItem Header="Redo (Ctrl+Y)" Click="OnRedoClick"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom In (Ctrl++)" Click="OnZoomInClick"/>
                <MenuItem Header="Zoom Out (Ctrl+-)" Click="OnZoomOutClick"/>
                <MenuItem Header="Fit Page (Ctrl+2)" Click="OnFitPageClick"/>
                <MenuItem Header="Fit Width (Ctrl+1)" Click="OnFitWidthClick"/>
                <Separator/>
                <MenuItem Header="Rotate Clockwise (Ctrl+R)" Click="OnRotateClick"/>
            </MenuItem>
            <MenuItem Header="_Go">
                <MenuItem Header="Previous Page (Page Up)" Click="OnPrevPageClick"/>
                <MenuItem Header="Next Page (Page Down)" Click="OnNextPageClick"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Notes (Ctrl+M)" Click="OnNotesClick"/>
                <MenuItem Header="_Search (Ctrl+F)" Click="OnSearchClick"/>
                <MenuItem Header="Export… (Ctrl+Shift+E)" Click="OnExportClick"/>
                <MenuItem Header="Page _Organizer…" Click="OnOrganizeClick"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource Brush.Surface}">
            <ToolBar Background="{StaticResource Brush.Surface}" Band="0" ToolBarTray.IsLocked="True">
                <Button Content="Open" Click="OnOpenClick"/>
                <Button Content="Save" Click="OnSaveClick" x:Name="SaveButton"/>
                <Separator/>
                <Button Content="◀ Prev" Click="OnPrevPageClick" x:Name="PrevButton"/>
                <TextBox x:Name="PageBox" Width="48" TextAlignment="Center" KeyDown="PageBox_KeyDown"/>
                <Button Content="Next ▶" Click="OnNextPageClick" x:Name="NextButton"/>
                <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource Brush.TextMuted}"/>
                <Separator/>
                <Button Content="Zoom −" Click="OnZoomOutClick"/>
                <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center">100%</TextBlock>
                <Button Content="Zoom +" Click="OnZoomInClick"/>
                <Button Content="Fit Width" Click="OnFitWidthClick"/>
                <Button Content="Fit Page" Click="OnFitPageClick"/>
                <Button Content="Rotate" Click="OnRotateClick"/>
                <Separator/>
                <Button x:Name="ToolSelect" Content="Select" Click="OnToolClick" Tag="Select"/>
                <Button x:Name="ToolInk" Content="Pen" Click="OnToolClick" Tag="Ink"/>
                <Button x:Name="ToolHighlighter" Content="Highlighter" Click="OnToolClick" Tag="Highlighter"/>
                <Button x:Name="ToolRectangle" Content="▭" Click="OnToolClick" Tag="Rectangle"/>
                <Button x:Name="ToolEllipse" Content="◯" Click="OnToolClick" Tag="Ellipse"/>
                <Button x:Name="ToolArrow" Content="↗" Click="OnToolClick" Tag="Arrow"/>
                <Button x:Name="ToolEraser" Content="Eraser" Click="OnToolClick" Tag="Eraser"/>
                <ComboBox x:Name="ColorPicker" Width="70" SelectionChanged="OnColorChanged" SelectedIndex="0">
                    <ComboBoxItem Tag="#F7768E"><Rectangle Width="14" Height="12" Fill="#F7768E"/></ComboBoxItem>
                    <ComboBoxItem Tag="#FAB387"><Rectangle Width="14" Height="12" Fill="#FAB387"/></ComboBoxItem>
                    <ComboBoxItem Tag="#A6E3A1"><Rectangle Width="14" Height="12" Fill="#A6E3A1"/></ComboBoxItem>
                    <ComboBoxItem Tag="#89DCEB"><Rectangle Width="14" Height="12" Fill="#89DCEB"/></ComboBoxItem>
                    <ComboBoxItem Tag="#89B4FA"><Rectangle Width="14" Height="12" Fill="#89B4FA"/></ComboBoxItem>
                    <ComboBoxItem Tag="#111111"><Rectangle Width="14" Height="12" Fill="#111111"/></ComboBoxItem>
                </ComboBox>
                <Separator/>
                <Button Content="Notes" Click="OnNotesClick"/>
                <Button Content="Search" Click="OnSearchClick"/>
                <Button Content="Export" Click="OnExportClick"/>
                <Button Content="Organize" Click="OnOrganizeClick"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Brush.Surface}" Foreground="{StaticResource Brush.Text}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. Open a PDF to begin."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="MarkupText" Foreground="{StaticResource Brush.TextMuted}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main body: sidebar + tabbed page view -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="Sidebar" Width="270" Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" Visibility="Collapsed">
                <TabControl x:Name="SidebarTabs" Background="Transparent">
                    <TabItem Header="Pages">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox x:Name="ThumbList" SelectionChanged="ThumbList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <Border Width="120" Height="160" Background="#14161B"
                                                    BorderBrush="#3A3E4B" BorderThickness="1">
                                                <Image Source="{Binding Image}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center"
                                                       Foreground="#9BA0AF" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Outline">
                        <TreeView x:Name="OutlineTree" SelectedItemChanged="OutlineTree_SelectedItemChanged"/>
                    </TabItem>
                    <TabItem Header="Bookmarks">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6">
                                <Button DockPanel.Dock="Right" Content="Add" Click="OnAddBookmarkClick"/>
                                <TextBox x:Name="BookmarkBox" />
                            </DockPanel>
                            <ListBox x:Name="BookmarkList" SelectionChanged="BookmarkList_SelectionChanged"/>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Notes">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="6">
                                <Button DockPanel.Dock="Right" Content="New" Click="OnNewNoteClick"/>
                                <ListBox x:Name="NoteList" Height="120" SelectionChanged="NoteList_SelectionChanged"/>
                            </DockPanel>
                            <DockPanel Margin="6">
                                <TextBox DockPanel.Dock="Top" x:Name="NoteTitle" TextChanged="NoteTitle_TextChanged" Margin="0,0,0,4"/>
                                <TextBox x:Name="NoteBody" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" TextChanged="NoteBody_TextChanged"/>
                            </DockPanel>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Search">
                        <DockPanel Margin="6">
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Content="Go" Click="OnSearchSubmitClick"/>
                                <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown"/>
                            </DockPanel>
                            <ListBox x:Name="SearchResults" SelectionChanged="SearchResults_SelectionChanged"/>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Column="1" x:Name="HostGrid">
                <TabControl x:Name="DocTabs" Background="Transparent" SelectionChanged="DocTabs_SelectionChanged"
                            BorderThickness="0" Padding="0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                <TextBlock x:Name="EmptyState" Text="Open a PDF to begin — drag one here or press Ctrl+O."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextMuted}" FontSize="16"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
