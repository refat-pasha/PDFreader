<Window x:Class="PDFreader.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#1B1D23">
    <StackPanel Margin="18">
        <TextBlock Text="This PDF is protected." FontWeight="SemiBold" FontSize="15"/>
        <TextBlock x:Name="FileNameText" Foreground="#9BA0AF" Margin="0,4,0,10" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="ErrorText" Text="That password was not accepted. Try again." Foreground="#F7768E"
                   Visibility="Collapsed" Margin="0,0,0,8"/>
        <TextBlock Text="Password"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,14" KeyDown="Password_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="84" Margin="0,0,8,0"/>
            <Button Content="Unlock PDF" Click="Ok_Click" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
