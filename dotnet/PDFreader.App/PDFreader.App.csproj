<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PDFreader</AssemblyName>
    <Version>0.2.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>PDFreader</AssemblyTitle>
    <Product>PDFreader</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFtoImage" Version="5.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.10" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PDFreader.Core\PDFreader.Core.csproj" />
  </ItemGroup>

</Project>
